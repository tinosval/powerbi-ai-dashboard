	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Projects\powerbi-ai-dashboard\sales_data_sample.csv"),[Delimiter=",", Columns=25, Encoding=1252, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
