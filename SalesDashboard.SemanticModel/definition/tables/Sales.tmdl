table Sales
	lineageTag: f6595bbb-9e26-44de-b1d3-ab21d827051a

	measure 'Total Sales' = SUM(Sales[SALES])
		formatString: $#,##0
		displayFolder: Key Measures
		lineageTag: 7b75d052-fbc1-4fd7-a5a9-5b929d0c75e0

	measure 'Total Quantity Sold' = SUM(Sales[QUANTITYORDERED])
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: ca6919a4-d341-4a37-9b22-c074cf691d81

	measure 'Total Orders' = DISTINCTCOUNT(Sales[ORDERNUMBER])
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: 0ad25b7a-52af-4921-aa3f-13f19f82c224

	measure 'Total Customers' = COUNTROWS(Customer)
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: 56a72a75-d607-43b1-aa9d-2e372081cc25

	measure 'Total Products Sold' = COUNTROWS(Product)
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: ca5685c6-496f-49f5-b786-5b7046dca543

	measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: $#,##0.00
		displayFolder: Key Measures
		lineageTag: 99a7fde5-53f6-49e3-943b-f40bca533cf0

	measure 'Average Selling Price' = AVERAGE(Sales[PRICEEACH])
		formatString: $#,##0.00
		displayFolder: Key Measures
		lineageTag: e80942c7-94ef-4349-b393-844345538c00

	measure '% of Total Sales' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALL(Sales)))
		formatString: 0.0%
		displayFolder: Key Measures
		lineageTag: e2a7940d-f104-404a-b24f-b52f049feef2

	/// Potential revenue at manufacturer list price (MSRP x quantity). Dataset has no cost data, so this is used as a proxy for margin analysis, not true profit.
	measure 'Total MSRP Value' = SUMX(Sales, Sales[QUANTITYORDERED] * Sales[MSRP])
		formatString: $#,##0
		displayFolder: Margin (MSRP-based)
		lineageTag: 410bd669-0bf5-4c2e-842f-54ca745f756a

	/// Amount actual sales fell short of MSRP list-price value. Not true profit (no cost data in source).
	measure 'Discount vs MSRP' = [Total MSRP Value] - [Total Sales]
		formatString: $#,##0
		displayFolder: Margin (MSRP-based)
		lineageTag: 4c9ebeee-8d9a-49ab-a816-ba4db7ea57ba

	measure 'Discount % vs MSRP' = DIVIDE([Discount vs MSRP], [Total MSRP Value])
		formatString: 0.0%
		displayFolder: Margin (MSRP-based)
		lineageTag: 46f75914-3a84-4371-a0e6-200056b8224e

	measure 'Sales PY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(Calendar[Date]))
		formatString: $#,##0
		displayFolder: Time Intelligence
		lineageTag: 7f10ac32-ee77-48da-aa22-0ad69ef63893

	measure 'Sales YoY %' = DIVIDE([Total Sales] - [Sales PY], [Sales PY])
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: cc8e0d7b-9894-4587-b188-c2c09394929e

	measure 'Sales YTD' = TOTALYTD([Total Sales], Calendar[Date])
		formatString: $#,##0
		displayFolder: Time Intelligence
		lineageTag: 3d6c2af8-f4a2-4ed9-af06-20538a6b8f1f

	measure 'Sales QTD' = TOTALQTD([Total Sales], Calendar[Date])
		formatString: $#,##0
		displayFolder: Time Intelligence
		lineageTag: 2f7f02dd-fcf5-4c83-87a7-8d224a90a7ba

	measure 'Sales MTD' = TOTALMTD([Total Sales], Calendar[Date])
		formatString: $#,##0
		displayFolder: Time Intelligence
		lineageTag: 0b13fa30-e5f5-4a93-b5d8-b8adfefd023b

	measure 'Sales - Large Deals' = CALCULATE([Total Sales], Sales[DEALSIZE] = "Large")
		formatString: $#,##0
		displayFolder: Deal Size
		lineageTag: 8df8d568-ce47-4d25-9cf3-e89db54b318a

	measure 'Sales - Medium Deals' = CALCULATE([Total Sales], Sales[DEALSIZE] = "Medium")
		formatString: $#,##0
		displayFolder: Deal Size
		lineageTag: ce9c4bf3-253d-4071-be35-264959a4bb3d

	measure 'Sales - Small Deals' = CALCULATE([Total Sales], Sales[DEALSIZE] = "Small")
		formatString: $#,##0
		displayFolder: Deal Size
		lineageTag: 1a7ec086-4437-4f98-b7d0-134d00f6b4e6

	measure 'Distinct Product Lines' = DISTINCTCOUNT(Sales[PRODUCTLINE])
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: cd3599b7-3285-4e29-9ee1-c37e1dfad277

	measure 'Distinct Countries' = DISTINCTCOUNT(Sales[COUNTRY])
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: 3e37edc9-a1aa-4a27-a010-9cf513d4d3e5

