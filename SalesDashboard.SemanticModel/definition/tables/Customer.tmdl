	partition Customer = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    VALUES(Sales[CUSTOMERNAME]),
				    "City", CALCULATE(SELECTEDVALUE(Sales[CITY])),
				    "State", CALCULATE(SELECTEDVALUE(Sales[STATE])),
				    "Postal Code", CALCULATE(SELECTEDVALUE(Sales[POSTALCODE])),
				    "Country", CALCULATE(SELECTEDVALUE(Sales[COUNTRY])),
				    "Territory", CALCULATE(SELECTEDVALUE(Sales[TERRITORY])),
				    "Contact First Name", CALCULATE(SELECTEDVALUE(Sales[CONTACTFIRSTNAME])),
				    "Contact Last Name", CALCULATE(SELECTEDVALUE(Sales[CONTACTLASTNAME])),
				    "Phone", CALCULATE(SELECTEDVALUE(Sales[PHONE]))
				)

